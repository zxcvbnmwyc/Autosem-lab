# Keep the real secret in sam2_trial/.env. That file is ignored by Git.
DASHSCOPE_API_KEY=

# Workspace-dedicated China (Beijing) OpenAI-compatible endpoint.
DASHSCOPE_BASE_URL=https://ws-jezurpmuo05q16c9.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-vl-flash
DASHSCOPE_TIMEOUT_SECONDS=45
# When Qwen can identify a point safely inside its candidate, add that positive
# point together with the candidate box before SAM2 runs.
QWEN_REPRESENTATIVE_POINT_ENABLED=false

# Local SAM2 is CPU-first for the early website. Tiny must use its matching
# checkpoint and config; change SAM2_DEVICE to cuda only when you deliberately
# want to use an NVIDIA GPU.
SAM2_DEVICE=cpu
SAM2_MODEL_VARIANT=tiny
SAM2_MODEL_NAME=sam2.1_hiera_tiny
SAM2_SOURCE=C:\Users\11609\Documents\Autosem\vendor\sam2-main
SAM2_CHECKPOINT=C:\Users\11609\Documents\Autosem\models\sam2.1_hiera_tiny.pt
SAM2_MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
SAM2_CPU_THREADS=4
# This caps only the image passed into SAM2's preprocessing on CPU. SAM2 Tiny
# internally works at 1024px, so lowering this below 1024 mainly trades away
# input detail rather than materially speeding up the encoder.
SAM2_MAX_IMAGE_EDGE=1280
SAM2_MAX_QUEUE=8

# Uploaded source images and results expire automatically after this many
# hours. Set 0 to keep them until you remove sam2_trial/data manually.
DATA_TTL_HOURS=72
MAX_UPLOAD_MB=25
MAX_IMAGE_PIXELS=12000000

# Browser-facing previews stay small and fast; full-size masks and contours
# remain available from the result download links.
DISPLAY_MAX_IMAGE_EDGE=1600
RESULT_PREVIEW_MAX_EDGE=1200
CLEANUP_INTERVAL_SECONDS=900

# Aggregated operational telemetry. The dashboard is at /ops and requires the
# separate token below; neither image content nor raw browser IDs are recorded.
METRICS_RETENTION_DAYS=30
OPS_DASHBOARD_TOKEN=

# Required before putting the service behind a public domain. Keep it private.
APP_SECRET_KEY=
